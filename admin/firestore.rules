rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ملاحظة: قواعد Firestore لا تدعم "قيد uniqueness" (منع تكرار اسم الفئة) بشكل مباشر عبر المستندات.
    // منع التكرار يتم من جهة لوحة التحكم (client-side) عبر:
    // - فحص الاسم قبل الإضافة
    // - زر "تنظيف التكرارات" لدمج/حذف المكرر
    // - Seed يعمل مرة واحدة فقط عندما لا توجد دروس
    // لفرض منع تكرار صارم على مستوى الخادم، استخدم Cloud Function أو معاملة تحفظ "اسم الفئة" كمفتاح في وثيقة فهرس.

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if isSignedIn();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0;
      allow delete: if isSignedIn();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.size() > 0
        && request.resource.data.type is string;
      allow delete: if isSignedIn();
    }
  }
}
