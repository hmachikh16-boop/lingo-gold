rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // قراءة عامة (للصور/الصوت المعروض في التطبيق)، كتابة للمستخدمين المسجلين فقط (لوحة التحكم)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
